# Copy to the systemd EnvironmentFile location and replace placeholders.
# Generate both secrets with: python3 -c 'import secrets; print(secrets.token_urlsafe(32))'
DASHBOARD_SECRET_KEY=replace-with-a-random-32-byte-secret
DASHBOARD_PASSWORD=replace-with-a-long-unique-admin-password
PIHOLE_PASSWORD=replace-with-pihole-password
# Keep 1 in production; set 0 only for a temporary local HTTP development session.
DASHBOARD_COOKIE_SECURE=1
