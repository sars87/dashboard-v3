#!/bin/bash
# ==========================================================
# Dashboard v6.0 Ultimate Deployment Installer (`deploy-v3`)
# ==========================================================
echo "==> [1/3] Pulling latest Dashboard v6.0 Ultimate from GitHub..."
cd /home/saif/deployments/dashboard-v3 2>/dev/null || {
    mkdir -p /home/saif/deployments
    git clone https://github.com/sars87/dashboard-v3.git /home/saif/deployments/dashboard-v3
    cd /home/saif/deployments/dashboard-v3
}
git pull origin main

echo "==> [2/3] Updating active dashboard script..."
sudo cp /home/saif/deployments/dashboard-v3/dashboard.py /home/saif/dashboard.py

echo "==> [3/3] Restarting dashboard systemd service..."
sudo systemctl restart dashboard.service

echo "=========================================================="
echo "✨ Dashboard v6.0 Ultimate deployed & updated successfully!"
echo "=========================================================="
