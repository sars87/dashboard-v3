#!/bin/bash
# ==========================================================
# v10.0 Robust Deployment Script (`deploy-v3`)
# ==========================================================
set -e

TARGET_USER="saif"
if id "$TARGET_USER" &>/dev/null; then
    USER_HOME="/home/$TARGET_USER"
else
    TARGET_USER="$(logname 2>/dev/null || whoami)"
    USER_HOME="/home/$TARGET_USER"
fi

TARGET_DIR="$USER_HOME/deployments/dashboard-v3"
REPO_URL="https://github.com/sars87/dashboard-v3.git"
CONFIG_FILE="$USER_HOME/.dashboard_repo_url"
ENV_FILE="/etc/dashboard/dashboard.env"
SERVICE_FILE="/etc/systemd/system/dashboard.service"

if [ -f "$CONFIG_FILE" ]; then
    CUSTOM_URL="$(tr -d '[:space:]' < "$CONFIG_FILE")"
    if [ -n "$CUSTOM_URL" ]; then REPO_URL="$CUSTOM_URL"; fi
fi

set_env_value() {
    local key="$1"
    local value="$2"
    local escaped
    escaped="$(printf '%s' "$value" | sed 's/[\\&/]/\\&/g')"
    if grep -q "^${key}=" "$ENV_FILE"; then
        sed -i "s#^${key}=.*#${key}=${escaped}#" "$ENV_FILE"
    else
        printf '%s=%s\n' "$key" "$value" >> "$ENV_FILE"
    fi
}

get_env_value() {
    if grep -q "^$1=" "$ENV_FILE"; then
        sed -n "s#^$1=##p" "$ENV_FILE" | tail -n 1
    fi
}

echo "==> [1/6] Preparing deployment directory for $TARGET_USER at $TARGET_DIR..."
sudo -u "$TARGET_USER" mkdir -p "$TARGET_DIR"

if [ -d "$TARGET_DIR/.git" ]; then
    echo "==> [2/6] Pulling latest changes from GitHub as $TARGET_USER..."
    sudo -u "$TARGET_USER" bash -c "cd '$TARGET_DIR' && git remote set-url origin '$REPO_URL' && git reset --hard HEAD && git pull --ff-only origin main"
else
    echo "==> [2/6] Cloning repository from GitHub as $TARGET_USER..."
    sudo -u "$TARGET_USER" git clone "$REPO_URL" "$TARGET_DIR"
fi

if [ ! -f "$TARGET_DIR/dashboard.py" ]; then
    echo "Error: dashboard.py was not found in the repository. Deployment stopped."
    exit 1
fi

echo "==> [3/6] Verifying Python syntax..."
python3 -B -c "import pathlib; [compile(pathlib.Path(p).read_text(), p, 'exec') for p in ('$TARGET_DIR/dashboard.py', '$TARGET_DIR/internet_monitor.py', '$TARGET_DIR/youtube_policy.py')]"

 echo "==> [4/6] Installing dashboard.py..."
cp "$TARGET_DIR/dashboard.py" "$USER_HOME/dashboard.py"
chown "$TARGET_USER:$TARGET_USER" "$USER_HOME/dashboard.py"

 echo "==> [5/6] Preparing dashboard environment..."
mkdir -p /etc/dashboard
touch "$ENV_FILE"
chmod 600 "$ENV_FILE"
chown root:root "$ENV_FILE"

# Never replace existing dashboard secrets or passwords.
if [ -z "$(get_env_value DASHBOARD_SECRET_KEY)" ]; then
    set_env_value DASHBOARD_SECRET_KEY "$(python3 -c 'import secrets; print(secrets.token_urlsafe(32))')"
fi
if ! grep -q '^DASHBOARD_PASSWORD=' "$ENV_FILE"; then
    set_env_value DASHBOARD_PASSWORD "Sars87"
fi
if ! grep -q '^DASHBOARD_COOKIE_SECURE=' "$ENV_FILE"; then
    set_env_value DASHBOARD_COOKIE_SECURE "0"
fi
if ! grep -q '^PIHOLE_PASSWORD=' "$ENV_FILE"; then
    set_env_value PIHOLE_PASSWORD ""
fi

# Electricity analytics defaults match e-app's sync contract.
if [ -z "$(get_env_value ELECTRICITY_BACKEND_URL)" ]; then
    set_env_value ELECTRICITY_BACKEND_URL "http://127.0.0.1:3000"
fi
if [ -z "$(get_env_value ELECTRICITY_WORKSPACE_KEY)" ]; then
    set_env_value ELECTRICITY_WORKSPACE_KEY "home"
fi
if ! grep -q '^ELECTRICITY_STATE_FILE=' "$ENV_FILE"; then
    set_env_value ELECTRICITY_STATE_FILE ""
fi
set_env_value ALLOW_LOCAL_ELECTRICITY_LATEST "1"
if ! grep -q '^DASHBOARD_INTERNET_STATE_FILE=' "$ENV_FILE"; then
    set_env_value DASHBOARD_INTERNET_STATE_FILE "$USER_HOME/.dashboard_internet_outages.json"
fi
if ! grep -q '^DASHBOARD_INTERNET_CHECK_INTERVAL=' "$ENV_FILE"; then
    set_env_value DASHBOARD_INTERNET_CHECK_INTERVAL "10"
fi

# Refresh the companion e-app backend when it is deployed on this server.
EAPP_DIR="${E_APP_DIR:-}"
if [ -z "$EAPP_DIR" ]; then
    for candidate in "$USER_HOME/e-app" "$USER_HOME/deployments/e-app" "$USER_HOME/ihtisab-istiلاك-kahrabaa"; do
        if [ -d "$candidate/.git" ]; then EAPP_DIR="$candidate"; break; fi
    done
fi
if [ -n "$EAPP_DIR" ] && [ -d "$EAPP_DIR/.git" ]; then
    echo "==> Updating local e-app backend for automatic electricity access..."
    sudo -u "$TARGET_USER" bash -c "cd '$EAPP_DIR' && git reset --hard HEAD && git pull --ff-only origin main"
    if command -v pnpm >/dev/null 2>&1; then
        sudo -u "$TARGET_USER" bash -c "cd '$EAPP_DIR' && pnpm install --frozen-lockfile && pnpm build"
    fi
    for svc in electricity-server.service e-app.service eapp.service electricity-backend.service; do
        if systemctl list-unit-files "$svc" --no-legend 2>/dev/null | grep -q "$svc"; then
            systemctl restart "$svc"
            break
        fi
    done
else
    echo "==> e-app backend directory not found; dashboard will use existing backend or local JSON."
fi

# Zero-input deployment: local e-app access works without a Sync Key. Keep any
# existing key, otherwise leave it empty and use the local latest endpoint.
if ! grep -q '^ELECTRICITY_SYNC_KEY=' "$ENV_FILE"; then
    set_env_value ELECTRICITY_SYNC_KEY ""
fi

if [ -f "$SERVICE_FILE" ] && ! grep -q '^EnvironmentFile=/etc/dashboard/dashboard.env' "$SERVICE_FILE"; then
    sed -i '/^\[Service\]/a EnvironmentFile=/etc/dashboard/dashboard.env' "$SERVICE_FILE"
fi

# Install the persistent internet outage monitor and its service. It records
# outages even when the dashboard is closed and survives dashboard restarts.
if [ ! -f "$TARGET_DIR/internet_monitor.py" ] || [ ! -f "$TARGET_DIR/dashboard-internet-monitor.service" ]; then
    echo "Error: outage monitor files are missing from the pulled repository. Deployment stopped."
    exit 1
fi
echo "==> Installing background internet outage monitor..."
install -m 0755 "$TARGET_DIR/internet_monitor.py" /usr/local/bin/internet_monitor.py
sed -e "s/^User=saif$/User=$TARGET_USER/" \
    -e "s/^Group=saif$/Group=$TARGET_USER/" \
    -e "s#^ExecStart=.*#ExecStart=/usr/bin/python3 /usr/local/bin/internet_monitor.py#" \
    -e "s#^Environment=DASHBOARD_INTERNET_STATE_FILE=.*#Environment=DASHBOARD_INTERNET_STATE_FILE=$USER_HOME/.dashboard_internet_outages.json#" \
    "$TARGET_DIR/dashboard-internet-monitor.service" > /etc/systemd/system/dashboard-internet-monitor.service
chmod 644 /etc/systemd/system/dashboard-internet-monitor.service

# Install and initialize granular YouTube policy and its minute scheduler.
if [ ! -f "$TARGET_DIR/youtube_policy.py" ] || [ ! -f "$TARGET_DIR/dashboard-youtube-policy.service" ] || [ ! -f "$TARGET_DIR/dashboard-youtube-policy.timer" ]; then
    echo "Error: YouTube policy files are missing from the pulled repository. Deployment stopped."
    exit 1
fi
install -m 0755 "$TARGET_DIR/youtube_policy.py" /usr/local/bin/youtube_policy.py
sed -e "s#^ExecStart=.*#ExecStart=/usr/bin/python3 /usr/local/bin/youtube_policy.py apply#" "$TARGET_DIR/dashboard-youtube-policy.service" > /etc/systemd/system/dashboard-youtube-policy.service
install -m 0644 "$TARGET_DIR/dashboard-youtube-policy.timer" /etc/systemd/system/dashboard-youtube-policy.timer
if [ ! -f "$USER_HOME/.dashboard_youtube_policy.json" ]; then
    printf '%s\n' '{"mode":"all","groups":[],"ips":[],"schedule_enabled":false,"start":"16:00","end":"22:00","days":[0,1,2,3,4,5,6],"manual_enabled":false}' > "$USER_HOME/.dashboard_youtube_policy.json"
    chown "$TARGET_USER:$TARGET_USER" "$USER_HOME/.dashboard_youtube_policy.json"
    chmod 0640 "$USER_HOME/.dashboard_youtube_policy.json"
fi
systemctl daemon-reload
systemctl enable --now dashboard-internet-monitor.service dashboard-youtube-policy.timer
python3 /usr/local/bin/youtube_policy.py init || true

 echo "==> [6/6] Restarting dashboard service..."
if systemctl restart dashboard.service; then
    systemctl is-active --quiet dashboard.service
else
    systemctl restart dashboard
    systemctl is-active --quiet dashboard
fi

install -m 0755 "$TARGET_DIR/deploy-v3" /usr/local/bin/deploy-v3

echo "=========================================================="
echo "v10.6 Deployed Successfully for $TARGET_USER"
echo "Electricity analytics: http://127.0.0.1:8088/electricity"
echo "=========================================================="
