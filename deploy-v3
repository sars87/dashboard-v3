#!/bin/bash
# ==========================================================
# Dashboard v8.7 Network Quota Edition Installer (`deploy-v3`)
# ==========================================================
set -e

echo "==> [1/4] Preparing deployment directory..."
TARGET_DIR="/home/$(whoami)/deployments/dashboard-v3"
mkdir -p "$TARGET_DIR"

REPO_URL="https://github.com/sars87/dashboard-v3.git"
CONFIG_FILE="/home/$(whoami)/.dashboard_repo_url"
if [ -f "$CONFIG_FILE" ]; then
    CUSTOM_URL=$(cat "$CONFIG_FILE" | tr -d '[:space:]')
    if [ ! -z "$CUSTOM_URL" ]; then
        REPO_URL="$CUSTOM_URL"
    fi
fi

if [ -d "$TARGET_DIR/.git" ]; then
    echo "==> [2/4] Pulling latest changes from GitHub ($REPO_URL)..."
    cd "$TARGET_DIR"
    git remote set-url origin "$REPO_URL"
    git reset --hard HEAD
    git pull origin main
else
    echo "==> [2/4] Cloning repository from GitHub ($REPO_URL)..."
    git clone "$REPO_URL" "$TARGET_DIR"
    cd "$TARGET_DIR"
fi

echo "==> [3/4] Installing / updating dashboard script..."
if [ -f "$TARGET_DIR/dashboard.py" ]; then
    USER_HOME=$(eval echo ~$(whoami))
    sudo cp "$TARGET_DIR/dashboard.py" "$USER_HOME/dashboard.py"
    sudo chown $(whoami):$(whoami) "$USER_HOME/dashboard.py"
    echo "==> Dashboard script successfully installed to $USER_HOME/dashboard.py"
else
    echo "Error: dashboard.py not found in repository!"
    exit 1
fi

echo "==> [4/4] Restarting dashboard systemd service..."
sudo systemctl restart dashboard.service || sudo systemctl restart dashboard

echo "=========================================================="
echo "✨ Dashboard v8.7 Network Quota deployed & updated successfully!"
echo "=========================================================="
