#!/bin/bash
# ==========================================================
# Dashboard v8.17.1 Robust Deployment Script (`deploy-v3`)
# ==========================================================
set -e

TARGET_USER="saif"
if id "saif" &>/dev/null; then
    USER_HOME="/home/saif"
else
    TARGET_USER=$(logname || whoami)
    USER_HOME="/home/$TARGET_USER"
fi

TARGET_DIR="$USER_HOME/deployments/dashboard-v3"
echo "==> [1/4] Preparing deployment directory for $TARGET_USER at $TARGET_DIR..."
sudo -u "$TARGET_USER" mkdir -p "$TARGET_DIR"

REPO_URL="git@github.com:sars87/dashboard-v3.git"
CONFIG_FILE="$USER_HOME/.dashboard_repo_url"
if [ -f "$CONFIG_FILE" ]; then
    CUSTOM_URL=$(cat "$CONFIG_FILE" | tr -d '[:space:]')
    if ! [ -z "$CUSTOM_URL" ]; then
        REPO_URL="$CUSTOM_URL"
    fi
fi

if [ -d "$TARGET_DIR/.git" ]; then
    echo "==> [2/4] Pulling latest changes from GitHub as $TARGET_USER ($REPO_URL)..."
    sudo -u "$TARGET_USER" bash -c "cd '$TARGET_DIR' && git remote set-url origin '$REPO_URL' && git reset --hard HEAD && (git pull origin main || git pull origin master || true)"
else
    echo "==> [2/4] Cloning repository from GitHub as $TARGET_USER ($REPO_URL)..."
    sudo -u "$TARGET_USER" git clone "$REPO_URL" "$TARGET_DIR" || {
        echo "==> Warning: SSH clone failed, trying HTTPS..."
        sudo -u "$TARGET_USER" git clone "https://github.com/sars87/dashboard-v3.git" "$TARGET_DIR"
    }
    sudo -u "$TARGET_USER" bash -c "cd '$TARGET_DIR' && git remote set-url origin '$REPO_URL'"
fi

echo "==> [3/4] Installing / updating dashboard script..."
if [ -f "$TARGET_DIR/dashboard.py" ]; then
    cp "$TARGET_DIR/dashboard.py" "$USER_HOME/dashboard.py"
    chown "$TARGET_USER:$TARGET_USER" "$USER_HOME/dashboard.py"
    echo "==> Dashboard script successfully installed to $USER_HOME/dashboard.py"
else
    echo "Error: dashboard.py not found in repository!"
    exit 1
fi

echo "==> [4/4] Restarting dashboard systemd service..."
systemctl restart dashboard.service || systemctl restart dashboard || true

echo "=========================================================="
echo "✨ Dashboard v8.17.1 Deployed Successfully for $TARGET_USER!"
echo "=========================================================="
